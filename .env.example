# Copy to `.env` and fill in values. `.env` is gitignored.

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-your-key-here
MARITIMEIQ_LLM_PROVIDER=openai
# MARITIMEIQ_MODEL=gpt-4o-mini

# --- Vertex AI (optional) ---
# MARITIMEIQ_LLM_PROVIDER=vertex
# MARITIMEIQ_MODEL=google/gemini-2.0-flash
# VERTEX_OPENAI_BASE_URL=https://YOUR_VERTEX_OPENAI_COMPAT_ENDPOINT/v1
# OPENAI_API_KEY=YOUR_VERTEX_TOKEN
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# VERTEX_LOCATION=us-central1

# --- Ops ---
# MARITIMEIQ_PII_SALT=maritimeiq-hackathon-salt
# GCS_BUCKET=gs://your-bucket/maritimeiq
